# Rust / Cargo
/target/
**/*.rs.bk
*.pdb

# Local-only scratch space — signing/notary credentials, never commit.
/ignore/

# Secrets / local env (never commit)
.env
.env.*
!.env.example
!.env.*.example

# Node / edge leftovers (historical; edge is gone but keep ignores)
node_modules/
.wrangler/
build/
edge/dist/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Local agent / app state (never commit)
.raven/
.grok/
.hearth/

# Extracted or dropped release packages (tarballs land under target/package/,
# which is already ignored; these catch manual extracts at the repo root)
/hearth-*-linux-*/
/hearth-*-macos-*/
/Hearth.app/
/*.tar.gz
/*.tgz
/*.dmg
/*.AppImage
/*.zip

# Logs / coverage / profiling
*.log
*.log.*
/coverage/
/lcov.info
/*.profraw
/*.profdata
